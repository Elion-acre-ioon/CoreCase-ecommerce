# ============================================================================
# .env.example
# ----------------------------------------------------------------------------
# Copie este arquivo para ".env" (que já é ignorado pelo Git) e preencha com
# os valores reais do seu ambiente. NUNCA suba o arquivo ".env" de verdade
# para o Git/GitHub — apenas este exemplo.
# ============================================================================

# --- Servidor ---
PORT=3000

# --- Banco de dados MySQL ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=corecase
MYSQL_PORT=3306

# --- Acesso administrativo ---
# Troque estes 3 valores antes de colocar em produção. Se não forem
# definidos, o sistema usa valores padrão de desenvolvimento e mostra um
# aviso no console.
ADMIN_TOKEN=troque-por-um-valor-secreto-e-unico
ADMIN_USER=admin
ADMIN_SENHA=troque-por-uma-senha-forte

# --- Cloudinary (armazenamento de imagens na nuvem) ---
# Opcional. Se deixar em branco, o sistema salva as imagens em disco local
# (pasta /uploads) — funciona bem localmente, mas NÃO é persistente em
# ambientes serverless (Netlify Functions). Para produção, recomendado
# preencher com uma conta gratuita em https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
